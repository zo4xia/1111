/* 候选人公示 · 页面独有布局
   ------------------------------------------------------------------
   已复用全局：card / blk-title / tag / chip / dot / note / avatar /
               trk（四轮审核轨迹）/ mask sheet / empty / hint / ico-prefix
   本页只允许保留：公文头、岗位分组、名单 chips、详情明细排版
   ------------------------------------------------------------------ */
.page { padding-bottom: var(--sp-5); }

/* —— 公文头（居中 + 鎏金分隔） —— */
.pub-head { text-align: center; }
.pub-title {
  color: var(--ink-1);
  font-family: var(--font-gongwen-h1);
  font-size: var(--fs-hero);
  font-weight: 700;
  line-height: var(--lh-snug);
  letter-spacing: var(--ls-hero);
}
.pub-rule { display: flex; align-items: center; justify-content: center; gap: var(--sp-3); margin: var(--sp-4) 0 var(--sp-3); }
.pr-line { width: 88rpx; height: 3rpx; background: linear-gradient(90deg, transparent, var(--c-jin)); border-radius: 2rpx; }
.pr-line:last-child { background: linear-gradient(90deg, var(--c-jin), transparent); }
.pr-diamond { width: 14rpx; height: 14rpx; background: var(--c-jin); transform: rotate(45deg); }
.pub-sub { color: var(--ink-1); font-family: var(--font-ui); font-size: var(--fs-note); letter-spacing: var(--ls-title); }
.pub-sum {
  margin-top: var(--sp-3);
  padding-top: var(--sp-3);
  border-top: 2rpx solid var(--line);
  color: var(--ink-3);
  font-size: var(--fs-mini);
  line-height: var(--lh-snug);
  letter-spacing: var(--ls-cap);
}

/* —— 岗位分组 —— */
.cg-head { display: flex; align-items: center; gap: var(--sp-3); }
.cg-no {
  display: flex; align-items: center; justify-content: center;
  width: 52rpx; height: 52rpx;
  flex-shrink: 0;
  background: var(--c-jin-bg);
  border: 2rpx solid var(--c-jin-line);
  border-radius: var(--r-sm);
  color: var(--c-jin-deep);
  font-size: var(--fs-sub);
  font-weight: 700;
}
.cg-title { flex: 1; min-width: 0; color: var(--ink-1); font-size: var(--fs-h); font-weight: 700; letter-spacing: var(--ls-h); }
/* 当前阶段条：进行中带呼吸点 */
.cg-stage {
  display: inline-flex; align-items: center; gap: 10rpx;
  margin-top: var(--sp-4); padding: var(--sp-2) var(--sp-4);
  background: var(--line-3); border-radius: var(--r-pill);
  color: var(--ink-3); font-size: var(--fs-mini); letter-spacing: var(--ls-cap);
}
.cg-stage.is-doing { background: var(--c-dai-bg); color: var(--c-dai-deep); font-weight: 600; }
.cg-gap { margin-top: var(--sp-3); }

/* 名单 chips（点名字弹明细） */
.cg-members {
  margin-top: var(--sp-4);
  padding-top: var(--sp-4);
  border-top: 2rpx solid var(--line-2);
  display: flex;
  flex-wrap: wrap;
  gap: var(--sp-3) var(--sp-2);
}
.cg-m {
  display: flex; align-items: center; gap: 10rpx;
  padding: var(--sp-2) var(--sp-4);
  background: var(--line-3);
  border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
}
.m-name { color: var(--ink-1); font-size: var(--fs-sub); font-weight: 600; letter-spacing: var(--ls-cap); }

/* —— 详情明细 —— */
.d-head { display: flex; gap: var(--sp-5); align-items: center; }
.d-head-main { flex: 1; min-width: 0; }
.d-line1 { display: flex; align-items: center; gap: 10rpx; }
.c-name { font-size: var(--fs-body); font-weight: 700; color: var(--ink-1); }
.c-meta { margin-top: 6rpx; font-size: var(--fs-mini); color: var(--ink-4); letter-spacing: var(--ls-cap); }
.d-status { margin-top: var(--sp-1); }
.d-warn { margin-top: var(--sp-5); }
.d-sec-t { margin-top: var(--sp-6); }
.d-votes { margin-top: var(--sp-5); font-size: var(--fs-note); font-weight: 700; color: var(--c-jin-deep); }
.d-note { margin-top: var(--sp-3); font-size: var(--fs-mini); color: var(--ink-3); line-height: var(--lh-base); }

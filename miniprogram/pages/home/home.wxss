/* 首页 · 页面独有布局
   ------------------------------------------------------------------
   已复用全局：card / card--brand / sec / blk-title / list-row / tag /
               chip / badge-dot / dot / empty / num / ico-prefix
   本页只允许保留：主横幅数据排版、四宫格入口、公告行角标列
   ------------------------------------------------------------------ */
.page { padding-bottom: var(--sp-7); }

/* —— 主横幅：全局品牌卡之上的数据排版 —— */
.hero-sub { font-size: var(--fs-cap); color: rgba(255, 255, 255, 0.88); letter-spacing: var(--ls-cap); }
.hero-title { margin-top: var(--sp-2); font-size: var(--fs-title); font-weight: 700; line-height: var(--lh-snug); letter-spacing: var(--ls-title); }
.hero-desc { margin-top: var(--sp-1); font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.75); letter-spacing: var(--ls-cap); }
.hero-row { display: flex; margin-top: var(--sp-5); }
.hero-item { flex: 1; text-align: center; position: relative; }
.hero-item + .hero-item::before {
  content: '';
  position: absolute; left: 0; top: 10rpx; bottom: 10rpx;
  width: 2rpx; background: rgba(255, 255, 255, 0.2);
}
.hero-num { font-size: var(--fs-h); font-weight: 700; color: var(--c-jin-light); }
.hero-lbl {
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  margin-top: 4rpx; font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.85);
  letter-spacing: var(--ls-cap);
}
.hero-stage {
  margin-top: var(--sp-4);
  padding: var(--sp-3) var(--sp-4);
  background: rgba(255, 255, 255, 0.14);
  border-left: 6rpx solid var(--c-jin-light);
  border-radius: var(--r-xs);
}
.hero-stage-name { font-size: var(--fs-mini); font-weight: 600; line-height: 1.5; letter-spacing: 1rpx; }
.hero-stage-range { margin-top: 4rpx; font-size: var(--fs-mini); color: rgba(255, 255, 255, 0.9); line-height: 1.5; }

/* —— 四宫格入口（卡片容器 + 自有栅格） —— */
.grid { display: flex; padding: var(--sp-3) 0; }
.grid-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: var(--sp-2) 0; }
.grid-ico {
  position: relative;
  display: flex; align-items: center; justify-content: center;
  width: 96rpx; height: 96rpx;
  border-radius: var(--r-lg);
  background: var(--c-dai-bg);
}
.grid-ico-img { width: 52rpx; height: 52rpx; }
.grid-lbl { margin-top: var(--sp-3); font-size: var(--fs-mini); color: var(--ink-2); font-weight: 600; letter-spacing: 1rpx; }

/* —— 公告行：角标列（置顶/类型竖排堆叠）+ 两行摘要标题 —— */
.ann-tags {
  flex-shrink: 0;
  width: 88rpx;
  display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx;
}
.ann-title {
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.ann-date { flex-shrink: 0; font-size: var(--fs-mini); color: var(--ink-4); }

/* —— 干部花名册：卡片式（淡青卡内嵌白色小卡，双层底色便于扫读） —— */
.roster-list { display: flex; flex-direction: column; gap: var(--sp-4); }
.roster-card {
  display: flex; align-items: flex-start; gap: var(--sp-4);
  padding: var(--sp-4) var(--sp-5);
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
}
.roster-av {
  display: flex; align-items: center; justify-content: center;
  width: 76rpx; height: 76rpx; flex-shrink: 0;
  background: var(--c-dai-bg);
  border-radius: 50%;
  color: var(--c-dai-deep);
  font-size: var(--fs-h);
  font-weight: 700;
}
.roster-main { flex: 1; min-width: 0; }
.roster-name {
  display: flex; align-items: center; gap: var(--sp-2);
  color: var(--ink-1);
  font-size: var(--fs-sub);
  font-weight: 700;
  letter-spacing: var(--ls-h);
  line-height: var(--lh-snug);
}
.roster-note { margin-top: 4rpx; color: var(--ink-3); font-size: var(--fs-mini); line-height: var(--lh-snug); }
.roster-meta {
  display: flex; align-items: center; gap: var(--sp-3);
  margin-top: var(--sp-2);
  color: var(--ink-3);
  font-size: var(--fs-mini);
}
